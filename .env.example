# Application Configuration
PORT=8081

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=token_service
DB_SSLMODE=disable

# Cronjob Configuration
# Format: @every <duration> OR standard cron format (e.g. 0 * * * *)
CRON_SCHEDULE="@every 1h"

# API Proxies / Overrides (Optional)
# If your ISP blocks Crypto Exchanges (e.g. Internet Positif), uncomment and use an alternative endpoint:
# BINANCE_API_URL="https://fapi.binance.me"
# OKX_API_URL="https://www.okx.com"
# BYBIT_API_URL="https://api.bybit.com"
# BITGET_API_URL="https://api.bitget.com"
# KUCOIN_API_URL="https://api-futures.kucoin.com"
# MEXC_API_URL="https://contract.mexc.com"

# HTTP Proxy (Alternative bypass method without changing URLs)
# HTTP_PROXY="http://127.0.0.1:7890"
# HTTPS_PROXY="http://127.0.0.1:7890"

# Auto Public Proxy (Easiest Bypass Method)
# Set to true to automatically route all requests through a free public CORS proxy.
# Very useful to bypass Internet Positif without installing a VPN.
USE_PUBLIC_PROXY="true"
